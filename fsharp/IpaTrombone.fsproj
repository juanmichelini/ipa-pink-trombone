<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pure core. Only FSharp.Core, so Fable can compile all of it to JavaScript. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- FS0025: a match that forgets a case is a build error, not a warning. -->
    <WarningsAsErrors>FS0025</WarningsAsErrors>
  </PropertyGroup>

  <!-- Compile order is lesson order: each file may use only the files above it. -->
  <ItemGroup>
    <Compile Include="src/01-TongueSpace.fs" />
    <Compile Include="src/02a-Score.fs" />
    <Compile Include="src/02b-Consonants.fs" />
    <Compile Include="src/03a-VowelShape.fs" />
    <Compile Include="src/03b-Ipa.fs" />
    <Compile Include="src/03c-Planner.fs" />
    <Compile Include="src/04a-G2p.fs" />
    <Compile Include="src/04b-Languages.fs" />
    <Compile Include="src/05-Voices.fs" />
    <Compile Include="src/06-Tempo.fs" />
    <Compile Include="src/07-Rhythm.fs" />
    <Compile Include="src/08-Accents.fs" />
  </ItemGroup>

</Project>
